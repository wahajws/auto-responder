# DashScope API key for Qwen (Alibaba Cloud)
# Get your key from: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Alibaba LLM API base URL (OpenAI-compatible endpoint)
ALIBABA_LLM_API_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Server port (optional, defaults to 3000)
PORT=3000
